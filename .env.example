# Database Connection (PostgreSQL for Vercel / Production)
# Example: Neon, Supabase, Vercel Postgres, AWS RDS, Railway
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/joycraft?sslmode=require"

# Cloudinary Integration for Persistent Media Uploads (Images & Music)
# Obtain credentials from Cloudinary Dashboard -> Product Environment Settings
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
